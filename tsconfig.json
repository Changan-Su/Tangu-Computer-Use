{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": ["./src/pi-compat.ts"],
      "@forsion/tangu-agent": ["./types/tangu-agent.d.ts"]
    }
  },
  "include": ["src", "types"]
}
