{
  "name": "@forsion/tangu-computer-use",
  "version": "0.7.2-jev.6",
  "description": "Tangu engine plugin: let agents observe and control macOS, Windows, and Linux desktop apps. Fork of injaneity/pi-computer-use (MIT).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Changan-Su/Tangu-Computer-Use.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tangu-plugin",
    "computer-use",
    "macos",
    "desktop-automation",
    "accessibility"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "tangu-plugins",
    "skills",
    "manifest.json",
    "icon.png",
    "main.js",
    "check.mjs",
    "install.sh",
    "CHANGELOG.md",
    "UPSTREAM.md",
    "tsconfig.json",
    "src",
    "types",
    "scripts",
    "prebuilt",
    "native/macos",
    "native/windows",
    "native/linux/bridge-rs",
    "LICENSE",
    "LICENSE.upstream",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "check:no-foreground": "node scripts/no-foreground.check.mjs",
    "check:helper-path": "node scripts/helper-path.check.mjs",
    "check:highlight": "node scripts/highlight.check.mjs",
    "check:capture-overlays": "node scripts/capture-overlays.check.mjs",
    "check:permissions": "node scripts/permissions.check.mjs",
    "check:plugin": "node check.mjs",
    "check:desk": "node scripts/desk-present.check.mjs",
    "check:first-click": "node scripts/first-click.check.mjs",
    "check:platform": "node scripts/platform-contract.check.mjs",
    "check:actions": "node scripts/actions.check.mjs",
    "check:blindclick": "node scripts/blind-click.check.mjs",
    "check:liveview": "node scripts/live-view.check.mjs",
    "check": "npm run check:platform && npm run check:actions && npm run check:no-foreground && npm run check:helper-path && npm run check:highlight && npm run check:capture-overlays && npm run check:permissions && npm run check:plugin && npm run check:helper-refresh && npm run check:installer && npm run check:cli-exit && npm run check:recorder-logic && npm run check:hotkey-logic && npm run check:exit-listeners && npm run check:jev && npm run check:desk",
    "build:native": "node scripts/build-native.mjs",
    "build:windows": "node scripts/build-native.mjs --platform windows",
    "build:linux": "node scripts/build-native.mjs --platform linux",
    "check:live": "npm run check:blindclick && npm run check:liveview && npm run check:overlay && npm run check:untargeted && npm run check:vision && npm run check:key-guard",
    "check:vision": "node scripts/vision-only.check.mjs",
    "check:untargeted": "node scripts/untargeted-input.check.mjs",
    "check:key-guard": "node scripts/key-guard.check.mjs",
    "check:overlay": "node scripts/overlay-visible.check.mjs",
    "check:mini-foreground": "node scripts/mini-foreground.check.mjs",
    "check:helper-refresh": "node scripts/helper-refresh.check.mjs",
    "check:helper-signal": "node scripts/helper-signal.check.mjs",
    "check:installer": "node scripts/keychain-free-install.check.mjs",
    "check:cli-exit": "node scripts/cli-exit.check.mjs",
    "check:exit-listeners": "node scripts/exit-listeners.check.mjs",
    "check:recorder-logic": "node scripts/recorder-logic.check.mjs",
    "check:recorder": "node scripts/recorder.check.mjs",
    "check:hotkey-logic": "node scripts/hotkey-logic.check.mjs",
    "check:hotkey": "node scripts/hotkey.check.mjs",
    "check:jev": "node scripts/jev.check.mjs",
    "check:jev-feedback-live": "node scripts/jev-feedback-live.check.mjs",
    "check:vision-fixtures": "node scripts/vision-fixtures.smoke.mjs",
    "calibrate:jev": "node scripts/jev-calibrate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
